# --- Version control ---------------------------------------------------------
.git/
.gitignore
.gitattributes

# --- Python build/cache ------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/
pip-wheel-cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

